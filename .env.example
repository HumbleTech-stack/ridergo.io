# ---- RiderGo configuration (copy to .env) ----
PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
CURRENCY=GHS
COUNTRY_CODES=gh
DEFAULT_LAT=5.6037
DEFAULT_LNG=-0.1870

# Paystack keys (https://dashboard.paystack.com/#/settings/developers)
# Leave empty to run in MOCK mode (a built-in fake checkout page is used).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Commission taken by the platform on online order/ride payments (percent)
COMMISSION_PCT=5
# Free trial days for new tenants (0 = must pay before going live)
TRIAL_DAYS=0
# Optional self-hosted OSRM routing server (defaults to the public demo server)
OSRM_URL=https://router.project-osrm.org

# Platform admin (created on first start)
ADMIN_EMAIL=admin@ridergo.app
ADMIN_PASSWORD=change-this-password
